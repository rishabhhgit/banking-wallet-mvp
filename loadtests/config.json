{
  "version": "0.46.0",
  "name": "banking-wallet-loadtest",
  "description": "Load tests for the Banking/Wallet System",
  "scripts": [
    "transfers.js"
  ],
  "config": {
    "transfers": {
      "stages": [
        { "duration": "10s", "target": 10 },
        { "duration": "30s", "target": 50 },
        { "duration": "1m", "target": 50 },
        { "duration": "10s", "target": 0 }
      ],
      "thresholds": {
        "http_req_duration": ["p(95)<2000"],
        "success_rate": ["rate>0.8"]
      }
    }
  }
}
